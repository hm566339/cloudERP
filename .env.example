# ==============================================================================
# Cloud ERP - Production Environment Configuration for https://www.mark2.in
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit your actual .env file with real credentials to Git!
# - Ensure all placeholder values are updated with secure production keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base URL & Routing Configuration
# ------------------------------------------------------------------------------
# External base URL of your server
PUBLIC_BASE_URL=https://www.mark2.in

# Frontend subpath base and API endpoint
VITE_BASE_PATH=/erp/
VITE_API_BASE_URL=/api

# Allowed origins for CORS (supports both domain and localhost:3001 access)
CORS_ALLOWED_ORIGINS=https://www.mark2.in,https://mark2.in,http://localhost:3001,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# 2. Docker Hub & Image Tag Settings
# ------------------------------------------------------------------------------
# Default image tag to deploy (overridden automatically by deploy.sh or CI/CD)
TAG=latest

# Optional Docker Hub credentials (only needed if repository is private)
DOCKERHUB_USERNAME=mohit950
DOCKERHUB_TOKEN=

# ------------------------------------------------------------------------------
# 3. Exposed Ports (Binds locally to host 127.0.0.1 for Host Reverse Proxy)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3001

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration (Internal Docker Network Only)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_database_password
POSTGRES_DB=postgres

# ------------------------------------------------------------------------------
# 4. Authentication / SSO Service (ERP_System)
# ------------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_very_strong_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRATION=3600000

ADMIN_USERNAME=admin@mark2.in
ADMIN_PASSWORD=Admin@123

# External endpoints (default constructed from PUBLIC_BASE_URL if left empty)
AUTH_SERVICE_EXTERNAL_URL=https://www.mark2.in/api/sso
# Internal microservice route URL used by Gateway (within Docker network)
SSO_INTERNAL_URL=http://auth-service:8090
FRONTEND_EXTERNAL_URL=https://www.mark2.in/erp/

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=harshomohit3@gmail.com
MAIL_PASSWORD=vrzpsoruphbozcwz
MAIL_AUTH=true
MAIL_STARTTLS_ENABLE=true

CLOUDINARY_CLOUD_NAME=aiq44cz9
CLOUDINARY_API_KEY=177525273989564
CLOUDINARY_API_SECRET=4U1XEpqHlaKXE_uJIZdwKCbLrrA

# Strapi CMS integration token (leave empty if not using Strapi)
STRAPI_TOKEN=

# Auto-create admin company on first startup
CREATE_ADMIN_COMPANY=true

# ------------------------------------------------------------------------------
# 5. Account Service (account-main)
# ------------------------------------------------------------------------------
ACCOUNT_SSO_CLIENT_ID=your_account_sso_client_id_uuid
ACCOUNT_SSO_CLIENT_SECRET=$2a$10$your_bcrypt_hashed_or_plain_client_secret

# Endpoints
ACCOUNT_FRONTEND_URL=https://www.mark2.in/erp/accounts
ACCOUNT_SSO_FRONTEND=https://www.mark2.in/erp/accounts
ACCOUNT_BASE_URL=https://www.mark2.in/api/account
ACCOUNT_SSO_LOGIN_URL=https://www.mark2.in/erp/login

# ------------------------------------------------------------------------------
# 6. Workflow Service (workflow-service)
# ------------------------------------------------------------------------------
WORKFLOW_CALLBACK_TIMEOUT_MS=5000
WORKFLOW_CALLBACK_RETRY_ENABLED=true
WORKFLOW_ATTACHMENT_STORAGE_PATH=uploads/workflow
WORKFLOW_ATTACHMENT_MAX_FILE_SIZE=10MB
WORKFLOW_ATTACHMENT_MAX_REQUEST_SIZE=15MB
WORKFLOW_SLA_CHECK_DELAY_MS=60000

# ------------------------------------------------------------------------------
# 7. Inventory Service (inventory)
# ------------------------------------------------------------------------------
INVENTORY_SSO_CLIENT_ID=
INVENTORY_SSO_CLIENT_SECRET=
INVENTORY_FRONTEND_URL=https://www.mark2.in/erp/inventory
INVENTORY_SSO_FRONTEND=https://www.mark2.in/erp/inventory
INVENTORY_BASE_URL=https://www.mark2.in/api/inventory
INVENTORY_SSO_LOGIN_URL=https://www.mark2.in/erp/login
# ------------------------------------------------------------------------------
# 8. Razorpay Recurring Billing & Subscription Configuration
# ------------------------------------------------------------------------------
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_BASE_URL=https://api.razorpay.com
