# ==============================================================================
# CloudERP Frontend - Local Development Environment (.env.development)
# ==============================================================================
# Local Vite dev server runs at http://localhost:3001/erp/
# All API requests are directed to local API Gateway at http://localhost:8080
# ==============================================================================

# Public subpath for React SPA
VITE_BASE_PATH=/erp/

# Local API Gateway Backend URL
VITE_API_BASE_URL=http://localhost:8080/api/

# SSO Base URL for Vite proxy fallback
VITE_SSO_BASE_URL=http://localhost:8080

# Local Print Service URL daemon
VITE_LOCAL_PRINT_URL=http://localhost:8089
