# ==============================================================================
# CloudERP Frontend - Local Development Environment (.env.development)
# ==============================================================================
# Local Vite dev server runs at http://localhost:3001/erp/
# All API requests are directed to the production backend at https://www.mark2.in/api/
# ==============================================================================

# Public subpath for React SPA
VITE_BASE_PATH=/erp/

# Production Backend API URL
VITE_API_BASE_URL=https://www.mark2.in/api/

# SSO Base URL for Vite proxy fallback
VITE_SSO_BASE_URL=https://www.mark2.in
