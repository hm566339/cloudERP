# ==============================================================================
# CloudERP Frontend - Environment Example (.env.example)
# ==============================================================================

# Public subpath for React SPA
VITE_BASE_PATH=/erp/

# Backend API URL (use https://www.mark2.in/api/ for dev against production, or /api for production)
VITE_API_BASE_URL=https://www.mark2.in/api/

# SSO Base URL for dev proxy
VITE_SSO_BASE_URL=https://www.mark2.in

# Local Print Service URL daemon
VITE_LOCAL_PRINT_URL=http://localhost:8089
