import React, { useState, useMemo } from 'react';
import { Plus, FileText, RefreshCw, RotateCcw, Search, Calendar, X, ArrowLeftRight, Trophy } from 'lucide-react';
import { useParams, useNavigate } from 'react-router-dom';
import { useApiQuery } from '../../../hooks/useApi';
import { supplierQuotationsApi, vendorsApi } from '../../../api/account';
import { useRBAC } from '../../../utils/rbac';
import useUrlFilters from '../../../hooks/useUrlFilters';
import Pagination from '../../../components/common/Pagination';
import { TableRowSkeleton } from '../../../components/common/SkeletonLoader';
import ColumnVisibilityToggle from '../../../components/common/ColumnVisibilityToggle';
import TableRowActions from '../../../components/common/TableRowActions';
import SortableHeader from '../../../components/common/SortableHeader';
import CustomSelect from '../../../components/common/CustomSelect';
import { useRoutePath } from '../../../hooks/useRoutePath';
import PurchaseNavigation from '../../../components/common/PurchaseNavigation';

const fmt = (n) => {
  if (n === null || n === undefined || isNaN(Number(n))) return '-';
  return `₹${Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
};

const renderStatusBadge = (status) => {
  if (!status) return <span className="text-zinc-400">-</span>;
  const s = String(status).toUpperCase();
  if (s === 'APPROVED' || s === 'ACCEPTED' || s === 'AWARDED') {
    return (
      <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-[#f0fdf4] text-[#16a34a] border border-[#bbf7d0]">
        {s}
      </span>
    );
  }
  if (s === 'SUBMITTED' || s === 'SENT') {
    return (
      <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-[#eff6ff] text-[#2563eb] border border-[#bfdbfe]">
        {s}
      </span>
    );
  }
  if (s === 'SHORTLISTED') {
    return (
      <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-[#f5f3ff] text-[#7c3aed] border border-[#ddd6fe]">
        {s}
      </span>
    );
  }
  if (s === 'DRAFT') {
    return (
      <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">
        DRAFT
      </span>
    );
  }
  if (s === 'REJECTED') {
    return (
      <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-[#fef2f2] text-[#dc2626] border border-[#fecaca]">
        REJECTED
      </span>
    );
  }
  if (s === 'CANCELLED') {
    return (
      <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-[#fafafa] text-[#71717a] border border-[#e4e4e7]">
        CANCELLED
      </span>
    );
  }
  return (
    <span className="inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
      {status}
    </span>
  );
};

export default function SupplierQuotations() {
  const companyId =
    useParams().companyId ||
    JSON.parse(localStorage.getItem('selected_company'))?.id ||
    JSON.parse(localStorage.getItem('auth_user'))?.companyCode;
  const navigate = useNavigate();
  const { buildPath } = useRoutePath();
  const { canCreate, canEdit, canApprove } = useRBAC();

  const {
    page,
    setPage,
    pageSize,
    setPageSize,
    apiParams,
    searchTerm: search,
    setSearchTerm: setSearch,
    debouncedSearch,
    sortBy,
    sortOrder,
    handleColumnSort,
    filters,
    setFilter
  } = useUrlFilters();

  const ALL_COLUMNS = [
    { id: 'quotationNumber', label: 'Quotation Number' },
    { id: 'rfqNumber', label: 'RFQ Number' },
    { id: 'vendorName', label: 'Supplier' },
    { id: 'quotationDate', label: 'Quotation Date' },
    { id: 'validUntil', label: 'Valid Until' },
    { id: 'taxableAmount', label: 'Taxable Amount' },
    { id: 'taxAmount', label: 'Tax' },
    { id: 'grandTotal', label: 'Grand Total' },
    { id: 'status', label: 'Status' },
    { id: 'actions', label: 'Actions' }
  ];

  const DEFAULT_COLUMNS = [
    'quotationNumber',
    'rfqNumber',
    'vendorName',
    'quotationDate',
    'validUntil',
    'grandTotal',
    'status',
    'actions'
  ];

  const [visibleColumns, setVisibleColumns] = useState(() => {
    try {
      const saved = localStorage.getItem('sq_visible_columns_v2');
      return saved ? JSON.parse(saved) : DEFAULT_COLUMNS;
    } catch {
      return DEFAULT_COLUMNS;
    }
  });

  const { data: vendorsResp } = useApiQuery(vendorsApi.getActiveVendors, undefined, { enabled: true });
  const vendorList = useMemo(() => {
    const list = Array.isArray(vendorsResp) ? vendorsResp : vendorsResp?.data || vendorsResp?.content || [];
    return Array.isArray(list) ? list : [];
  }, [vendorsResp]);

  const vendorOptions = vendorList.map(v => ({
    value: v.id,
    label: v.vendorName || v.name || 'Unnamed Vendor',
    subLabel: v.vendorCode || v.code || undefined
  }));

  const listFilters = useMemo(
    () => ({
      search: debouncedSearch || undefined,
      status: filters.status || undefined,
      quotationDateFrom: filters.quotationDateFrom || undefined,
      quotationDateTo: filters.quotationDateTo || undefined,
      vendorId: filters.vendorId || undefined,
      companyId
    }),
    [debouncedSearch, filters.status, filters.quotationDateFrom, filters.quotationDateTo, filters.vendorId, companyId]
  );

  const payload = {
    ...apiParams,
    ...listFilters,
    search: undefined
  };

  const { data: apiData = {}, isLoading, isFetching, refetch } = useApiQuery(supplierQuotationsApi.getList, {
    ...payload
  });

  let allQuotations = Array.isArray(apiData) ? apiData : apiData?.data?.content || apiData?.content || [];

  if (debouncedSearch) {
    const s = debouncedSearch.toLowerCase();
    allQuotations = allQuotations.filter(
      q =>
        q.quotationNumber?.toLowerCase().includes(s) ||
        q.vendorName?.toLowerCase().includes(s) ||
        q.rfqNumber?.toLowerCase().includes(s)
    );
  }
  if (filters.status) {
    allQuotations = allQuotations.filter(q => q.status === filters.status);
  }

  const sortedQuotations = useMemo(() => {
    if (!sortBy) return allQuotations;
    return [...allQuotations].sort((a, b) => {
      let aVal = a[sortBy];
      let bVal = b[sortBy];
      if (aVal == null) return 1;
      if (bVal == null) return -1;
      if (typeof aVal === 'string') {
        const cmp = aVal.localeCompare(bVal);
        return sortOrder === 'desc' ? -cmp : cmp;
      }
      return sortOrder === 'desc' ? bVal - aVal : aVal - bVal;
    });
  }, [allQuotations, sortBy, sortOrder]);

  const extractedTotalElements =
    apiData?.data?.pagination?.totalElements || apiData?.pagination?.totalElements || sortedQuotations.length;
  const actualTotalElements =
    sortedQuotations.length < extractedTotalElements ? sortedQuotations.length : extractedTotalElements;

  const currentSize = pageSize || 10;

  const pageInfo = {
    totalPages: Math.ceil(actualTotalElements / currentSize) || 1,
    totalElements: actualTotalElements
  };

  const isFullyLoaded =
    (Array.isArray(apiData) || sortedQuotations.length === extractedTotalElements) && sortedQuotations.length > 0;
  const shouldSlice = isFullyLoaded || debouncedSearch || filters.status;

  const quotations = shouldSlice
    ? sortedQuotations.slice(page * currentSize, (page + 1) * currentSize)
    : sortedQuotations;

  const handleReset = () => {
    setSearch('');
    setFilter('status', '');
    setFilter('quotationDateFrom', '');
    setFilter('quotationDateTo', '');
    setFilter('vendorId', '');
  };

  const isTerminal = (status) =>
    ['AWARDED', 'CANCELLED', 'REJECTED', 'CLOSED'].includes(String(status || '').toUpperCase());
  const canEditRow = (q) => !isTerminal(q.status) && canEdit();
  const canAwardRow = (q) => !isTerminal(q.status) && canApprove();

  const getExtraActionsForRow = (q) => {
    const actions = [];
    if (q.rfqId) {
      actions.push({
        icon: <ArrowLeftRight size={14} />,
        tooltip: 'Compare Quotations',
        onClick: () => navigate(buildPath(`/accounts/transactions/supplier-quotations/compare/${q.rfqId}`)),
        className: 'text-zinc-700 hover:bg-blue-50 hover:text-blue-600 cursor-pointer'
      });
    }
    if (canAwardRow(q)) {
      actions.push({
        icon: <Trophy size={14} />,
        tooltip: 'Award',
        onClick: () =>
          navigate(buildPath(`/accounts/transactions/supplier-quotations/${q.id}`), { state: { award: true } }),
        className: 'text-zinc-700 hover:bg-emerald-50 hover:text-emerald-600 cursor-pointer'
      });
    }
    return actions;
  };

  return (
    <div className="flex flex-col h-full bg-zinc-50/50">
      <PurchaseNavigation />

      {/* Page Header */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 bg-white border-b border-zinc-200">
        <div>
          <h1 className="text-2xl font-bold text-zinc-900 tracking-tight">Supplier Quotations</h1>
          <p className="text-sm text-zinc-500 mt-1">
            Supplier bids submitted against your RFQs for comparison and award
          </p>
        </div>
        <div className="flex items-center gap-3">
          <ColumnVisibilityToggle
            allColumns={ALL_COLUMNS}
            visibleColumns={visibleColumns}
            setVisibleColumns={(cols) => {
              setVisibleColumns(cols);
              localStorage.setItem('sq_visible_columns_v2', JSON.stringify(cols));
            }}
            buttonClassName="h-9 px-3.5 text-xs font-semibold text-zinc-700 hover:text-zinc-900 bg-white border border-zinc-200 rounded-lg hover:bg-zinc-50 transition-all active:scale-95 shadow-2xs flex items-center gap-2 cursor-pointer"
          />
          {canCreate() && (
            <button
              onClick={() => navigate(buildPath('/accounts/transactions/supplier-quotations/new'))}
              className="h-9 px-4 text-xs font-semibold text-white bg-zinc-900 hover:bg-zinc-800 rounded-lg flex items-center gap-2 transition-all active:scale-95 shadow-xs cursor-pointer"
            >
              <Plus size={16} /> <span>New Supplier Quotation</span>
            </button>
          )}
        </div>
      </div>

      {/* Main Content Area */}
      <div className="flex-1 p-6 overflow-hidden flex flex-col">
        <div className="bg-white rounded-xl shadow-sm border border-zinc-200 flex flex-col h-full overflow-hidden">
          
          {/* Filter Card */}
          <div className="p-4 border-b border-zinc-200 bg-white">
            <form onSubmit={(e) => { e.preventDefault(); refetch(); }} className="space-y-3">
              {/* Row 1: Search, Quotation Date From, Quotation Date To, Supplier */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                {/* Search */}
                <div>
                  <label className="text-[8.8px] font-bold text-zinc-500 uppercase tracking-wider mb-1 block">
                    SEARCH
                  </label>
                  <div className="relative">
                    <Search
                      size={15}
                      className="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none"
                    />
                    <input
                      type="text"
                      placeholder="Search quotations..."
                      value={search || ''}
                      onChange={(e) => setSearch(e.target.value)}
                      className="w-full h-9 pl-8 pr-3 bg-white border border-zinc-200 rounded-lg text-[10.4px] text-zinc-800 placeholder-zinc-400 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-900/10 outline-none transition-all"
                    />
                    {search && (
                      <button
                        type="button"
                        onClick={() => setSearch('')}
                        className="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-600 cursor-pointer"
                      >
                        <X size={13} />
                      </button>
                    )}
                  </div>
                </div>

                {/* Quotation Date From */}
                <div>
                  <label className="text-[8.8px] font-bold text-zinc-500 uppercase tracking-wider mb-1 block">
                    QUOTATION DATE FROM
                  </label>
                  <div className="relative">
                    <Calendar
                      size={15}
                      className="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none"
                    />
                    <input
                      type="date"
                      placeholder="mm/dd/yyyy"
                      value={filters.quotationDateFrom || ''}
                      onChange={(e) => setFilter('quotationDateFrom', e.target.value)}
                      className="w-full h-9 pl-8 pr-3 bg-white border border-zinc-200 rounded-lg text-[10.4px] text-zinc-800 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-900/10 outline-none transition-all"
                    />
                  </div>
                </div>

                {/* Quotation Date To */}
                <div>
                  <label className="text-[8.8px] font-bold text-zinc-500 uppercase tracking-wider mb-1 block">
                    QUOTATION DATE TO
                  </label>
                  <div className="relative">
                    <Calendar
                      size={15}
                      className="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none"
                    />
                    <input
                      type="date"
                      placeholder="mm/dd/yyyy"
                      value={filters.quotationDateTo || ''}
                      onChange={(e) => setFilter('quotationDateTo', e.target.value)}
                      className="w-full h-9 pl-8 pr-3 bg-white border border-zinc-200 rounded-lg text-[10.4px] text-zinc-800 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-900/10 outline-none transition-all"
                    />
                  </div>
                </div>

                {/* Supplier */}
                <div>
                  <label className="text-[8.8px] font-bold text-zinc-500 uppercase tracking-wider mb-1 block">
                    SUPPLIER
                  </label>
                  <CustomSelect
                    value={filters.vendorId || ''}
                    onChange={(e) => setFilter('vendorId', e.target.value)}
                    options={vendorOptions}
                    placeholder="All Suppliers"
                    emptyMessage="No suppliers available"
                    searchable
                    buttonClassName="w-full h-9 px-3 bg-white border border-zinc-200 rounded-lg text-[10.4px] font-medium text-zinc-800 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-900/10 outline-none transition-all cursor-pointer"
                  />
                </div>
              </div>

              {/* Row 2: Status on left, Reset & Refresh on right */}
              <div className="flex flex-wrap items-end justify-between gap-3 pt-1">
                <div className="w-full sm:w-64">
                  <label className="text-[8.8px] font-bold text-zinc-500 uppercase tracking-wider mb-1 block">
                    STATUS
                  </label>
                  <CustomSelect
                    value={filters.status || ''}
                    onChange={(e) => setFilter('status', e.target.value)}
                    placeholder="All Statuses"
                    searchable={false}
                    buttonClassName="w-full h-9 px-3 bg-white border border-zinc-200 rounded-lg text-[10.4px] font-medium text-zinc-800 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-900/10 outline-none transition-all cursor-pointer"
                  >
                    <option value="">All Statuses</option>
                    <option value="DRAFT">Draft</option>
                    <option value="SUBMITTED">Submitted</option>
                    <option value="SENT">Sent</option>
                    <option value="SHORTLISTED">Shortlisted</option>
                    <option value="ACCEPTED">Accepted</option>
                    <option value="AWARDED">Awarded</option>
                    <option value="REJECTED">Rejected</option>
                    <option value="CANCELLED">Cancelled</option>
                    <option value="CLOSED">Closed</option>
                  </CustomSelect>
                </div>

                {/* Filter Action Buttons */}
                <div className="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    onClick={handleReset}
                    className="h-9 px-3 text-[10.4px] font-semibold text-zinc-600 hover:text-zinc-900 bg-white border border-zinc-200 rounded-lg hover:bg-zinc-50 transition-all flex items-center gap-1.5 active:scale-95 shadow-2xs cursor-pointer"
                    title="Reset all filters"
                  >
                    <RotateCcw size={14} />
                    <span>Reset</span>
                  </button>

                  <button
                    type="button"
                    onClick={() => refetch()}
                    className="h-9 px-3 text-[10.4px] font-semibold text-zinc-600 hover:text-zinc-900 bg-white border border-zinc-200 rounded-lg hover:bg-zinc-50 transition-all flex items-center gap-1.5 active:scale-95 shadow-2xs cursor-pointer"
                    title="Refresh List"
                  >
                    <RefreshCw size={14} className={isLoading || isFetching ? 'animate-spin' : ''} />
                    <span>Refresh</span>
                  </button>
                </div>
              </div>
            </form>
          </div>

          {/* Table Container */}
          <div className="erp-table-container overflow-x-auto flex-1">
            <table className="erp-table w-full text-left border-collapse whitespace-nowrap text-sm">
              <thead className="bg-zinc-50 border-b border-zinc-200 text-zinc-500 font-medium">
                <tr>
                  <th className="p-4 w-12 text-center text-[8.8px] font-bold uppercase tracking-wider text-zinc-500">
                    #
                  </th>
                  {visibleColumns.includes('quotationNumber') && (
                    <SortableHeader
                      label="QUOTATION NUMBER"
                      field="quotationNumber"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4"
                    />
                  )}
                  {visibleColumns.includes('rfqNumber') && (
                    <SortableHeader
                      label="RFQ NUMBER"
                      field="rfqNumber"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4"
                    />
                  )}
                  {visibleColumns.includes('vendorName') && (
                    <SortableHeader
                      label="SUPPLIER"
                      field="vendorName"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4"
                    />
                  )}
                  {visibleColumns.includes('quotationDate') && (
                    <SortableHeader
                      label="QUOTATION DATE"
                      field="quotationDate"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4"
                    />
                  )}
                  {visibleColumns.includes('validUntil') && (
                    <SortableHeader
                      label="VALID UNTIL"
                      field="validUntil"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4"
                    />
                  )}
                  {visibleColumns.includes('taxableAmount') && (
                    <th className="p-4 text-right text-[8.8px] font-bold uppercase tracking-wider text-zinc-500">
                      Taxable Amount
                    </th>
                  )}
                  {visibleColumns.includes('taxAmount') && (
                    <th className="p-4 text-right text-[8.8px] font-bold uppercase tracking-wider text-zinc-500">
                      Tax
                    </th>
                  )}
                  {visibleColumns.includes('grandTotal') && (
                    <SortableHeader
                      label="GRAND TOTAL"
                      field="grandTotal"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4 text-right"
                    />
                  )}
                  {visibleColumns.includes('status') && (
                    <SortableHeader
                      label="STATUS"
                      field="status"
                      sortBy={sortBy}
                      sortOrder={sortOrder}
                      onSort={handleColumnSort}
                      className="p-4 text-center"
                    />
                  )}
                  {visibleColumns.includes('actions') && (
                    <th className="p-4 text-right sticky right-0 bg-zinc-50 z-10 shadow-[-10px_0_15px_-3px_rgba(0,0,0,0.05)] text-[8.8px] font-bold uppercase tracking-wider text-zinc-500">
                      ACTIONS
                    </th>
                  )}
                </tr>
              </thead>
              <tbody className="divide-y divide-zinc-100">
                {isLoading || isFetching ? (
                  <TableRowSkeleton columns={visibleColumns.length + 1} rows={10} />
                ) : quotations.length === 0 ? (
                  <tr>
                    <td colSpan={visibleColumns.length + 1} className="p-12 text-center text-zinc-500">
                      <div className="flex flex-col items-center justify-center">
                        <div className="w-12 h-12 bg-zinc-100 rounded-full flex items-center justify-center mb-3">
                          <FileText className="text-zinc-400" size={24} />
                        </div>
                        <p className="text-sm font-medium text-zinc-700">No supplier quotations found</p>
                        <p className="text-xs text-zinc-400 mt-1">
                          Create a supplier quotation against an RFQ to see it here.
                        </p>
                      </div>
                    </td>
                  </tr>
                ) : (
                  quotations.map((q, idx) => {
                    const rowId = q.id || idx;
                    return (
                      <tr key={rowId} className="hover:bg-zinc-50/80 transition-colors group">
                        <td className="p-4 text-center text-zinc-400 font-normal">
                          {page * currentSize + idx + 1}
                        </td>

                        {visibleColumns.includes('quotationNumber') && (
                          <td className="p-4">
                            <div className="flex items-center gap-2">
                              <FileText size={14} className="text-zinc-400 shrink-0" />
                              <span className="font-mono text-xs font-semibold text-zinc-800 tracking-tight">
                                {q.quotationNumber || '-'}
                              </span>
                            </div>
                          </td>
                        )}

                        {visibleColumns.includes('rfqNumber') && (
                          <td className="p-4">
                            <span className="font-mono text-xs font-semibold text-zinc-600">
                              {q.rfqNumber || q.rfqId || '-'}
                            </span>
                          </td>
                        )}

                        {visibleColumns.includes('vendorName') && (
                          <td className="p-4 font-semibold text-zinc-900 text-xs">
                            {q.vendorName || q.vendor?.name || '-'}
                          </td>
                        )}

                        {visibleColumns.includes('quotationDate') && (
                          <td className="p-4 text-zinc-600 text-xs">
                            {q.quotationDate ? new Date(q.quotationDate).toLocaleDateString() : '-'}
                          </td>
                        )}

                        {visibleColumns.includes('validUntil') && (
                          <td className="p-4 text-zinc-600 text-xs">
                            {q.validUntil ? new Date(q.validUntil).toLocaleDateString() : '-'}
                          </td>
                        )}

                        {visibleColumns.includes('taxableAmount') && (
                          <td className="p-4 text-right text-zinc-600 font-mono text-xs">
                            {fmt(q.taxableAmount)}
                          </td>
                        )}

                        {visibleColumns.includes('taxAmount') && (
                          <td className="p-4 text-right text-zinc-600 font-mono text-xs">
                            {fmt(q.taxAmount)}
                          </td>
                        )}

                        {visibleColumns.includes('grandTotal') && (
                          <td className="p-4 text-right font-semibold text-zinc-900 font-mono text-xs">
                            {fmt(q.grandTotal)}
                          </td>
                        )}

                        {visibleColumns.includes('status') && (
                          <td className="p-4 text-center">
                            {renderStatusBadge(q.status)}
                          </td>
                        )}

                        {visibleColumns.includes('actions') && (
                          <td
                            className="p-4 text-right sticky right-0 bg-white shadow-[-10px_0_15px_-3px_rgba(0,0,0,0.05)] group-hover:bg-zinc-50/80 transition-colors"
                            onClick={(e) => e.stopPropagation()}
                          >
                            <TableRowActions
                              onView={() =>
                                navigate(buildPath(`/accounts/transactions/supplier-quotations/${q.id}`))
                              }
                              onEdit={
                                canEditRow(q)
                                  ? () =>
                                      navigate(
                                        buildPath(`/accounts/transactions/supplier-quotations/${q.id}/edit`)
                                      )
                                  : undefined
                              }
                              extraActions={getExtraActionsForRow(q)}
                              size={16}
                            />
                          </td>
                        )}
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>

          {/* Pagination Container */}
          {pageInfo && actualTotalElements > 0 && (
            <Pagination
              currentPage={page}
              totalPages={pageInfo.totalPages}
              onPageChange={setPage}
              totalElements={pageInfo.totalElements}
              pageSize={currentSize}
              onPageSizeChange={setPageSize}
            />
          )}
        </div>
      </div>
    </div>
  );
}