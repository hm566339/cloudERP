# Build Stage
FROM maven:3.9.9-eclipse-temurin-17 AS builder

WORKDIR /app

COPY . .

RUN mvn clean package -DskipTests

# Runtime Stage
FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=builder /app/target/*.jar app.jar

# GST master import file, read from the working directory at startup
COPY --from=builder /app/Sales_MT_2026-27_592.xlsx Sales_MT_2026-27_592.xlsx

EXPOSE 8081

ENTRYPOINT ["java","-jar","app.jar"]