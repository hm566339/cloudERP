  input_sgst_account_id uuid
  input_igst_account_id uuid
  input_cess_account_id uuid
  total_amount decimal(19,4)
  freight_charges decimal(19,4)
  total_before_round_off decimal(19,4)
  round_off decimal(19,4)
  paid_amount decimal(19,4)
  outstanding_amount decimal(19,4)
  tds_amount decimal(19,4)
  gl_journal_entry_id uuid
  reverse_gl_journal_entry_id uuid
  gl_posting_status varchar  // PostingStatus enum
  gl_posting_time timestamp
  status varchar  // InvoiceStatus enum
  approved_by uuid
  approved_at timestamp
  place_of_supply_state_id uuid
  place_of_supply_state_code varchar(10)
  vendor_address_id uuid
  purchase_address_line1 varchar
  purchase_address_line2 varchar
  purchase_city varchar
  purchase_state varchar
  purchase_postal_code varchar
  purchase_country varchar
  purchase_order_id uuid
  goods_receipt_id uuid
  purchase_source varchar(40)  // PurchaseSource enum
  document_type varchar(40)  // PurchaseDocumentType enum
  purchase_nature varchar(20)  // PurchaseNature enum
  payment_type varchar(20)  // PaymentType enum
  gst_treatment varchar(30)  // GstTreatment enum
  itc_eligibility varchar(30)  // ItcEligibility enum
  itc_reason varchar(500)
  supplier_invoice_number varchar(100)
  supplier_invoice_date date
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table ap_invoice_item {
  id uuid [pk]
