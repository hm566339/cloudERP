  claim_no varchar
  claim_date date
  claim_amount decimal(19,4)
  status varchar  // ApprovalStatus enum
  expense_request_id uuid
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table expense_claim_item {
  id uuid [pk]
  company_id uuid [not null]
  expense_claim_id uuid [not null]
  expense_category_id uuid [not null]
  expense_date date
  description varchar
  amount decimal(19,4)
  bill_attachment_url varchar
  payment_type varchar(30)  // PaymentType enum
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table reimbursement {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  expense_claim_id uuid [not null]
  reimbursement_no varchar(50) [not null]
  reimbursement_date date [not null]
  reimbursement_amount decimal(19,4) [not null]
  status varchar  // ReimbursementStatus enum
  payment_method varchar  // PaymentMode enum
  payment_reference varchar
  payment_date date
  notes text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

// ============================================================
// SETTINGS
// ============================================================

Table unit_master {
  id uuid [pk]
  code varchar(50) [unique, not null]
  name varchar(100) [not null]
  symbol varchar(20)
  allow_decimal boolean [not null, default: true]
  decimal_places int [default: 2]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    code [unique, name: 'idx_unit_code']
  }
}

Table payment_term {
  id uuid [pk]
  company_id uuid [not null]
  name varchar(255) [not null]
  description text
  is_default boolean [default: false]
  is_active boolean [default: true]
  document_type varchar(50) [not null]  // SalesDocumentType enum
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, is_active, is_deleted) [name: 'idx_payment_term_company_active']
  }
}

Table terms_condition {
  id uuid [pk]
  company_id uuid [not null]
  title varchar(255) [not null]
  content text
  is_default boolean [default: false]
  is_active boolean [default: true]
  document_type varchar(50) [not null]  // SalesDocumentType enum
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, is_active, is_deleted) [name: 'idx_terms_condition_company_active']
  }
}

Table delivery_term {
  id uuid [pk]
  company_id uuid [not null]
  document_type varchar(50) [not null]  // SalesDocumentType enum
  name varchar [not null]
  description text
  is_default boolean [default: false]
  is_active boolean [default: true]
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table warranty_term {
  id uuid [pk]
  company_id uuid [not null]
  document_type varchar(50) [not null]  // SalesDocumentType enum
  name varchar [not null]
  description text
  is_default boolean [default: false]
  is_active boolean [default: true]
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

// ============================================================
// WORKFLOW / AUDIT / FISCAL
// ============================================================

Table workflow_definition {
  id uuid [pk]
  company_id uuid [not null]
  workflow_code varchar(100) [not null]
  workflow_name varchar(255) [not null]
  module_name varchar(100)
  document_type varchar(100) [not null]
  description text
  version int [default: 1, not null]
  is_active boolean [default: true, not null]
  is_default boolean [default: false, not null]
  effective_from timestamp
  effective_to timestamp
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table workflow_stage {
  id uuid [pk]
  workflow_definition_id uuid [not null]
  stage_code varchar(100) [not null]
  stage_name varchar(255) [not null]
  stage_order int
  sequence_no int [not null]
  execution_type varchar(50) [default: 'SEQUENTIAL', not null]
  minimum_approvals_required int [default: 1, not null]
  rejection_action varchar(50) [default: 'REJECT_DOCUMENT', not null]
  is_mandatory boolean [default: true, not null]
  is_active boolean [default: true, not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table workflow_transaction {
  id uuid [pk]
  company_id uuid [not null]
  workflow_definition_id uuid [not null]
  entity_name varchar
  entity_id uuid
  document_type varchar(100) [not null]
  document_id uuid [not null]
  document_number varchar(100)
  current_stage_id uuid
  status varchar(50) [default: 'PENDING', not null]
  initiated_by uuid [not null]
  initiated_by_name varchar(255)
  initiated_at timestamp
  submitted_at timestamp [not null]
  completed_at timestamp
  cancelled_at timestamp
  version bigint [default: 0, not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table workflow_approver {
  id uuid [pk]
  workflow_stage_id uuid [not null]
  approver_type varchar(50) [not null]
  user_id uuid
  user_name varchar(255)
  role_id uuid
  role_name varchar(100)
  department_id uuid
  department_name varchar(100)
  rule_expression text
  approval_order int [default: 1, not null]
  is_required boolean [default: true, not null]
  can_delegate boolean [default: true, not null]
  created_at timestamp
  updated_at timestamp
  is_deleted boolean [default: false, not null]
}

Table workflow_transition {
  id uuid [pk]
  workflow_definition_id uuid [not null]
  action_type varchar(50) [not null]
  source_stage_id uuid
  target_stage_id uuid
  transition_condition text
  allowed_roles varchar(255)
  is_active boolean [default: true, not null]
  created_at timestamp
  updated_at timestamp
  is_deleted boolean [default: false, not null]
}

Table workflow_task {
  id uuid [pk]
  workflow_transaction_id uuid [not null]
  workflow_stage_id uuid [not null]
  assigned_user_id uuid
  assigned_role_name varchar(100)
  delegated_from_user_id uuid
  task_status varchar(50) [default: 'PENDING', not null]
  action_taken varchar(50)
  assigned_at timestamp [not null]
  due_at timestamp
  completed_at timestamp
  completed_by uuid
  completed_by_name varchar(255)
  comments text
  version bigint [default: 0, not null]
  created_at timestamp
  updated_at timestamp
  is_deleted boolean [default: false, not null]
}

Table workflow_action {
  id uuid [pk]
  workflow_transaction_id uuid [not null]
  workflow_task_id uuid
  action_type varchar(50) [not null]
  performed_by uuid [not null]
  performed_by_name varchar(255)
  previous_status varchar(50)
  new_status varchar(50)
  comments text
  metadata jsonb
  ip_address varchar(100)
  created_at timestamp [not null]
}

Table workflow_comment {
  id uuid [pk]
  workflow_transaction_id uuid [not null]
  workflow_task_id uuid
  user_id uuid [not null]
  user_name varchar(255)
  comment_text text [not null]
  is_internal boolean [default: false, not null]
  created_at timestamp
  updated_at timestamp
  is_deleted boolean [default: false, not null]
}

Table workflow_attachment {
  id uuid [pk]
  workflow_transaction_id uuid [not null]
  workflow_task_id uuid
  file_name varchar(255) [not null]
  stored_file_name varchar(255) [not null]
  file_url varchar(500) [not null]
  content_type varchar(100) [not null]
  file_size bigint [not null]
  uploaded_by uuid [not null]
  uploaded_by_name varchar(255)
  created_at timestamp
  updated_at timestamp
  is_deleted boolean [default: false, not null]
}

Table workflow_sla {
  id uuid [pk]
  workflow_stage_id uuid [not null]
  duration_hours int [not null]
  reminder_hours int
  escalation_action varchar(50) [default: 'NOTIFY_MANAGER', not null]
  escalate_to_user_id uuid
  escalate_to_role_name varchar(100)
  is_active boolean [default: true, not null]
  created_at timestamp
  updated_at timestamp
  is_deleted boolean [default: false, not null]
}

Table workflow_notification {
  id uuid [pk]
  company_id uuid [not null]
  workflow_transaction_id uuid [not null]
  workflow_task_id uuid
  recipient_user_id uuid [not null]
  notification_type varchar(50) [not null]
  title varchar(255) [not null]
  message text [not null]
  is_read boolean [default: false, not null]
  read_at timestamp
  channel varchar(50) [default: 'IN_APP', not null]
  delivery_status varchar(50) [default: 'SENT', not null]
  created_at timestamp [not null]
}

Table audit_log {
  id uuid [pk]
  company_id uuid
  module_name varchar
  entity_name varchar
  entity_id uuid
  action_type varchar
  old_value jsonb
  new_value jsonb
  performed_by uuid
  performed_by_username varchar
  performed_at timestamp
  ip_address varchar
  user_agent varchar
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_audit_log_company']
    entity_name [name: 'idx_audit_log_entity']
    performed_by [name: 'idx_audit_log_user']
  }
}

Table fiscal_year {
  id uuid [pk]
  company_id uuid [not null]
  fiscal_year varchar(100) [not null]
  start_date date [not null]
  end_date date [not null]
  is_closed boolean [not null, default: false]  // FiscalYearStatus enum -> boolean
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, fiscal_year) [unique, name: 'uk_fiscal_year_company_name']
  }
}

Table accounting_period {
  id uuid [pk]
  company_id uuid [not null]
  fiscal_year_id uuid [not null]
  period_number int [not null]
  period_name varchar(100) [not null]
  start_date date [not null]
  end_date date [not null]
  period_type varchar(20) [not null, default: 'CUSTOM']  // PeriodType enum
  status varchar(20) [not null, default: 'OPEN']  // AccountingPeriodStatus enum
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (fiscal_year_id, period_number) [unique, name: 'uk_accounting_period_fiscal_year_number']
    (fiscal_year_id, period_name) [unique, name: 'uk_accounting_period_fiscal_year_name']
  }
}

Table voucher_sequence {
  id uuid [pk]
  company_id uuid [not null]
  voucher_type varchar(100) [not null]
  prefix varchar(20) [not null]
  next_number bigint [not null]
  padding_length int [not null]
  is_active boolean [not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, voucher_type) [unique, name: 'uk_voucher_sequence_company_type']
  }
}

Table gl_balance_snapshot {
  id uuid [pk]
  company_id uuid [not null]
  account_id uuid [not null]
  fiscal_year_id uuid
  accounting_period_id uuid
  snapshot_date date
  opening_balance decimal(19,4) [default: 0]
  debit_amount decimal(19,4) [default: 0]
  credit_amount decimal(19,4) [default: 0]
  closing_balance decimal(19,4) [default: 0]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_balance_company_id']
    account_id [name: 'idx_balance_account_id']
    accounting_period_id [name: 'idx_balance_period_id']
  }
}

// ============================================================
// INTEGRATION
// ============================================================

Table inventory_sync_task {
  id uuid [pk]
  company_id uuid [not null]
  invoice_id uuid [not null]
  event_type varchar(50) [not null]
  status varchar(30) [not null]  // SyncStatus enum
  retry_count int [not null, default: 0]
  last_error text
  token text
  next_retry_at timestamp
  payload text
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    invoice_id [name: 'idx_inv_sync_task_invoice']
    status [name: 'idx_inv_sync_task_status']
    next_retry_at [name: 'idx_inv_sync_task_next_retry']
  }
}

// ============================================================
// RELATIONSHIPS
// ============================================================

// --- Chart of Accounts ---
Ref: company.id < account_category.company_id
Ref: company.id < account_group.company_id
Ref: account_category.id < account_group.category_id
Ref: account_group.id < account_group.parent_group_id
Ref: company.id < chart_of_account.company_id
Ref: account_group.id < chart_of_account.group_id
Ref: chart_of_account.id < chart_of_account.parent_account_id

// --- GL Journal ---
Ref: company.id < gl_journal_entry.company_id
Ref: fiscal_year.id < gl_journal_entry.fiscal_year_id
Ref: accounting_period.id < gl_journal_entry.accounting_period_id
Ref: gl_journal_entry.id < gl_journal_line.journal_entry_id
Ref: company.id < gl_journal_line.company_id
Ref: chart_of_account.id < gl_journal_line.account_id

// --- Tax transaction ---
Ref: company.id < tax_transaction.company_id
Ref: hsn_sac_master.id < tax_transaction.hsn_sac_id

// --- Customers / Vendors ---
Ref: company.id < customer.company_id
Ref: customer.id < customer_address.customer_id
Ref: gst_state_code.id < customer_address.gst_state_id
Ref: company.id < vendor.company_id
Ref: chart_of_account.id < vendor.payable_account_id
Ref: vendor.id < vendor_address.vendor_id
Ref: gst_state_code.id < vendor_address.gst_state_id

// --- Sales cycle ---
Ref: company.id < quotation.company_id
Ref: customer.id < quotation.customer_id
Ref: quotation.id < quotation_item.quotation_id
Ref: hsn_sac_master.id < quotation_item.hsn_sac_id
Ref: quotation.id < quotation_acceptance_token.quotation_id

Ref: company.id < proforma_invoice.company_id
Ref: quotation.id < proforma_invoice.source_quotation_id
Ref: customer.id < proforma_invoice.customer_id
Ref: proforma_invoice.id < proforma_invoice_item.proforma_invoice_id
Ref: quotation_item.id < proforma_invoice_item.source_quotation_item_id
Ref: hsn_sac_master.id < proforma_invoice_item.hsn_sac_id

Ref: company.id < sales_order.company_id
Ref: proforma_invoice.id < sales_order.source_pi_id
Ref: quotation.id < sales_order.source_quotation_id
Ref: customer.id < sales_order.customer_id
Ref: sales_order.id < sales_order_item.sales_order_id
Ref: proforma_invoice_item.id < sales_order_item.source_pi_item_id
Ref: hsn_sac_master.id < sales_order_item.hsn_sac_id

Ref: company.id < delivery_challan.company_id
Ref: sales_order.id < delivery_challan.source_so_id
Ref: sales_invoice.id < delivery_challan.source_si_id
Ref: receipt_voucher.id < delivery_challan.source_rv_id
Ref: customer.id < delivery_challan.customer_id
Ref: delivery_challan.id < delivery_challan_item.delivery_challan_id
Ref: sales_order_item.id < delivery_challan_item.source_so_item_id
Ref: sales_invoice_item.id < delivery_challan_item.source_si_item_id
Ref: hsn_sac_master.id < delivery_challan_item.hsn_sac_id

Ref: company.id < sales_invoice.company_id
Ref: customer.id < sales_invoice.customer_id
Ref: delivery_challan.id < sales_invoice.source_delivery_challan_id
Ref: sales_invoice.id < sales_invoice_item.sales_invoice_id
Ref: hsn_sac_master.id < sales_invoice_item.hsn_sac_id
Ref: sales_invoice.id < invoice_tax.sales_invoice_id
Ref: gst_slab.id < invoice_tax.gst_slab_id

Ref: company.id < credit_note.company_id
Ref: sales_invoice.id < credit_note.sales_invoice_id
Ref: company.id < debit_note.company_id
Ref: ap_invoice.id < debit_note.ap_invoice_id

// --- Purchase cycle ---
Ref: company.id < purchase_requisition.company_id
Ref: purchase_requisition.id < purchase_requisition_item.purchase_requisition_id

Ref: company.id < rfq.company_id
Ref: purchase_requisition.id < rfq.purchase_requisition_id
Ref: rfq.id < rfq_item.rfq_id
Ref: rfq.id < rfq_vendor.rfq_id
Ref: vendor.id < rfq_vendor.vendor_id

Ref: company.id < supplier_quotation.company_id
Ref: rfq.id < supplier_quotation.rfq_id
Ref: vendor.id < supplier_quotation.vendor_id
Ref: supplier_quotation.id < supplier_quotation_item.quotation_id
Ref: hsn_sac_master.id < supplier_quotation_item.hsn_sac_id

Ref: company.id < purchase_order.company_id
Ref: vendor.id < purchase_order.vendor_id
Ref: purchase_order.id < purchase_order_item.purchase_order_id
Ref: hsn_sac_master.id < purchase_order_item.hsn_sac_id

Ref: company.id < goods_receipt.company_id
Ref: vendor.id < goods_receipt.vendor_id
Ref: purchase_order.id < goods_receipt.purchase_order_id
Ref: goods_receipt.id < goods_receipt_item.goods_receipt_id
Ref: purchase_order_item.id < goods_receipt_item.purchase_order_item_id

Ref: company.id < purchase_return.company_id
Ref: goods_receipt.id < purchase_return.goods_receipt_id
Ref: purchase_order.id < purchase_return.purchase_order_id
Ref: vendor.id < purchase_return.vendor_id
Ref: purchase_return.id < purchase_return_item.purchase_return_id

Ref: company.id < ap_invoice.company_id
Ref: vendor.id < ap_invoice.vendor_id
Ref: ap_invoice.id < ap_invoice_item.ap_invoice_id

Ref: company.id < einvoice_request.company_id
Ref: sales_invoice.id < einvoice_request.sales_invoice_id

// --- Banking & Payments ---
Ref: company.id < bank_account.company_id
Ref: chart_of_account.id < bank_account.gl_account_id
Ref: company.id < bank_transaction.company_id
Ref: bank_account.id < bank_transaction.bank_account_id

Ref: company.id < ap_payment.company_id
Ref: vendor.id < ap_payment.vendor_id
Ref: bank_account.id < ap_payment.bank_account_id
Ref: ap_payment.id < ap_payment_allocation.ap_payment_id
Ref: ap_invoice.id < ap_payment_allocation.ap_invoice_id

Ref: company.id < payment_voucher.company_id
Ref: vendor.id < payment_voucher.vendor_id
Ref: bank_account.id < payment_voucher.bank_account_id
Ref: chart_of_account.id < payment_voucher.payable_account_id
Ref: chart_of_account.id < payment_voucher.payment_account_id
Ref: purchase_order.id < payment_voucher.purchase_order_id
Ref: payment_voucher.id < payment_voucher_allocation.payment_voucher_id
Ref: ap_invoice.id < payment_voucher_allocation.ap_invoice_id
Ref: purchase_order.id < payment_voucher_allocation.purchase_order_id

Ref: company.id < receipt_voucher.company_id
Ref: customer.id < receipt_voucher.customer_id
Ref: bank_account.id < receipt_voucher.bank_account_id
Ref: chart_of_account.id < receipt_voucher.receivable_account_id
Ref: chart_of_account.id < receipt_voucher.receipt_account_id
Ref: sales_invoice.id < receipt_voucher.sales_invoice_id
Ref: receipt_voucher.id < receipt_allocation.receipt_voucher_id
Ref: sales_invoice.id < receipt_allocation.sales_invoice_id
Ref: proforma_invoice.id < receipt_allocation.proforma_invoice_id

// --- GST / Tax ---
Ref: gst_slab.id < hsn_sac_master.gst_slab_id
Ref: company.id < gst_registration.company_id
Ref: gst_state_code.id < gst_registration.state_code_id
Ref: country.id < gst_state_code.country_id

// --- Budget ---
Ref: company.id < budget_header.company_id
Ref: fiscal_year.id < budget_header.fiscal_year_id
Ref: budget_header.id < budget_line.budget_header_id
Ref: company.id < budget_line.company_id
Ref: chart_of_account.id < budget_line.account_id

// --- Expense ---
Ref: company.id < expense_category.company_id
Ref: chart_of_account.id < expense_category.expense_account_id
Ref: company.id < expense_request.company_id
Ref: expense_category.id < expense_request.expense_category_id
Ref: company.id < expense_claim.company_id
Ref: company.id < expense_claim_item.company_id
Ref: expense_claim.id < expense_claim_item.expense_claim_id
Ref: expense_category.id < expense_claim_item.expense_category_id
