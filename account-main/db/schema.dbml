  purchase_address_line2 varchar
  purchase_city varchar(100)
  purchase_state varchar(100)
  purchase_country varchar(100)
  purchase_postal_code varchar(20)
  shipping_address_snapshot text
  reference_number varchar(100)
  supplier_quotation_id uuid
  rfq_id uuid
  purchase_requisition_id uuid
  payment_terms text
  delivery_terms text
  terms_and_conditions text
  notes text
  subtotal decimal(19,4) [not null, default: 0]
  discount_amount decimal(19,4) [default: 0]
  taxable_amount decimal(19,4) [not null, default: 0]
  cgst_amount decimal(19,4) [default: 0]
  sgst_amount decimal(19,4) [default: 0]
  igst_amount decimal(19,4) [default: 0]
  cess_amount decimal(19,4) [default: 0]
  tax_amount decimal(19,4) [not null, default: 0]
  freight_charges decimal(19,4) [default: 0]
  other_charges decimal(19,4) [default: 0]
  total_before_round_off decimal(19,4) [not null, default: 0]
  round_off decimal(19,4) [default: 0]
  total_amount decimal(19,4) [not null, default: 0]
  advance_required boolean [default: false]
  advance_amount decimal(19,4) [default: 0]
  advance_paid_amount decimal(19,4) [default: 0]
  status varchar(30) [not null, default: 'DRAFT']  // PurchaseOrderStatus enum
  approved_by uuid
  approved_at timestamp
  rejection_reason text
  cancelled_reason text
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_po_company']
    vendor_id [name: 'idx_po_vendor']
    po_number [unique, name: 'idx_po_number']
    status [name: 'idx_po_status']
  }
}

