  billing_address_line1 varchar
  billing_address_line2 varchar
  billing_city varchar
  billing_state varchar
  billing_postal_code varchar
  billing_country varchar
  billing_state_code varchar(10)
  status varchar(30) [not null]  // InvoiceStatus enum
  approved_by uuid
  approved_at timestamp
  gl_journal_entry_id uuid
  gl_posting_status varchar  // PostingStatus enum
  posted_by uuid
  posted_at timestamp
  payment_term_id uuid
  payment_terms text
  terms_condition_id uuid
  terms_and_conditions text
  delivery_terms text
  notes text
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, invoice_number) [unique, name: 'uk_sales_invoice_company_number']
    company_id [name: 'idx_sales_invoice_company']
    customer_id [name: 'idx_sales_invoice_customer']
    status [name: 'idx_sales_invoice_status']
    invoice_date [name: 'idx_sales_invoice_invoice_date']
    due_date [name: 'idx_sales_invoice_due_date']
    invoice_number [name: 'idx_sales_invoice_number']
    source_sales_order_id [name: 'idx_sales_invoice_so']
    source_delivery_challan_id [name: 'idx_sales_invoice_dc']
  }
}

