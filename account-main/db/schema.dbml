Project accounting_erp {
  database_type: 'PostgreSQL'
  Note: 'ACCOUNTING ERP - Database Schema (Spring Boot / JPA / Hibernate)'
}

// ============================================================
// CORE / COMPANY
// ============================================================

Table company {
  id uuid [pk]
  company_code varchar
  company_name varchar
  gstin varchar
  base_currency varchar
  email varchar(255)
  phone varchar(20)
  address_line_1 varchar(255)
  address_line_2 varchar(255)
  city varchar(100)
  state varchar(100)
  country varchar(100)
  postal_code varchar(20)
  company_type varchar(100)
  legal_name varchar(255)
  logo_url varchar(500)
  pan varchar(20)
  website varchar(255)
  active boolean [default: true, not null]
  initialization_completed boolean [default: false]
  initialization_in_progress boolean [default: false]
  is_composition_scheme boolean [default: false]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table country {
  id uuid [pk]
  country_code varchar(10) [unique, not null]
  country_name varchar(100) [not null]
  iso_country_code varchar(3)
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

Table account_category {
  id uuid [pk]
  company_id uuid [not null]
  code varchar(50) [not null]
  name varchar(255) [not null]
  nature varchar [not null]  // AccountNature enum (STRING)
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, code) [unique]
  }
}

Table account_group {
  id uuid [pk]
  company_id uuid [not null]
  category_id uuid [not null]
  parent_group_id uuid
  code varchar(50) [not null]
  name varchar [not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, code) [unique, name: 'uk_account_group_company_code']
  }
}

Table chart_of_account {
  id uuid [pk]
  company_id uuid [not null]
  group_id uuid [not null]
  parent_account_id uuid
  account_code varchar [not null]
  account_name varchar [not null]
  account_type varchar [not null]  // AccountNature enum (STRING)
  posting_allowed boolean
  is_active boolean
  opening_balance decimal(19,4)
  is_deleted boolean [default: false]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, account_code) [unique]
  }
}

Table tax_transaction {
  id uuid [pk]
  company_id uuid [not null]
  source_type varchar
  source_id uuid
  hsn_sac_id uuid
  taxable_amount decimal(19,4)
  cgst_amount decimal(19,4)
  sgst_amount decimal(19,4)
  igst_amount decimal(19,4)
  cess_amount decimal(19,4)
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

// ============================================================
// GL JOURNAL (DOUBLE ENTRY)
// ============================================================

Table gl_journal_entry {
  id uuid [pk]
  company_id uuid [not null]
  fiscal_year_id uuid
  accounting_period_id uuid
  voucher_no varchar(20) [not null]
  voucher_date date [not null]
  reference_no varchar(50)
  source_module varchar(30)  // SourceModule enum
  source_id uuid
  event_type varchar(60)
  idempotency_key varchar(200)
  narration text
  status varchar [not null, default: 'DRAFT']  // PostingStatus enum
  total_debit decimal(19,4) [default: 0]
  total_credit decimal(19,4) [default: 0]
  hash_value text
  previous_hash text
  hash_algorithm varchar(50) [default: 'SHA-256']
  posted_by uuid
  posted_at timestamp
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_gl_journal_entry_company_id']
    voucher_date [name: 'idx_voucher_date']
    status [name: 'idx_status']
    (company_id, voucher_no) [unique, name: 'idx_company_voucher_no']
    (company_id, voucher_date, status) [name: 'idx_gl_journal_entry_company_date_status']
    (company_id, fiscal_year_id) [name: 'idx_gl_journal_entry_company_fiscal_year']
    (company_id, source_module, source_id, event_type) [unique, name: 'uk_gl_manufacturing_source']
    (company_id, source_module, idempotency_key) [unique, name: 'uk_gl_manufacturing_idempotency']
  }
}

Table gl_journal_line {
  id uuid [pk]
  company_id uuid [not null]
  journal_entry_id uuid [not null]
  account_id uuid
  debit_amount decimal(19,4) [default: 0]
  credit_amount decimal(19,4) [default: 0]
  currency_code varchar(3)
  exchange_rate decimal(19,6)
  line_description text
  branch_id uuid
  cost_center_id uuid
  project_id uuid
  department_id uuid
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_gl_journal_line_company_id']
    journal_entry_id [name: 'idx_journal_entry_id']
    account_id [name: 'idx_account_id']
    (company_id, account_id) [name: 'idx_gl_journal_line_company_account']
    (company_id, branch_id) [name: 'idx_gl_journal_line_company_branch']
    (company_id, cost_center_id) [name: 'idx_gl_journal_line_company_cost_center']
    (company_id, project_id) [name: 'idx_gl_journal_line_company_project']
    (company_id, department_id) [name: 'idx_gl_journal_line_company_department']
  }
}

// ============================================================
// CUSTOMERS / VENDORS
// ============================================================

Table customer {
  id uuid [pk]
  company_id uuid [not null]
  customer_code varchar
  customer_name varchar [not null]
  gstin varchar
  pan_no varchar
  email varchar
  phone varchar
  credit_limit decimal(19,4)
  is_active boolean
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table customer_address {
  id uuid [pk]
  customer_id uuid [not null]
  address_type varchar(50) [not null]
  address_line1 varchar [not null]
  address_line2 varchar
  city varchar [not null]
  gst_state_id uuid
  country varchar [not null]
  postal_code varchar(20)
  is_default boolean [not null]
  is_active boolean [not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

Table vendor {
  id uuid [pk]
  company_id uuid [not null]
  vendor_code varchar [not null]
  vendor_name varchar [not null]
  gstin varchar
  pan_no varchar
  email varchar
  phone varchar
  address_line1 varchar
  city varchar
  state varchar
  country varchar
  pin_code varchar
  credit_limit decimal(19,4)
  payable_account_id uuid [not null]
  opening_balance decimal(19,4)
  opening_balance_date date
  payment_term_days int
  default_currency varchar(3)
  tds_applicable boolean [default: false, not null]
  tds_section varchar(30)
  tds_rate decimal(9,4)
  is_active boolean [default: true, not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, vendor_code) [unique, name: 'uk_vendor_code_company']
    (company_id, gstin) [unique, name: 'uk_vendor_gstin']
    (pan_no, company_id) [unique, name: 'uk_vendor_pan_company']
  }
}

Table vendor_address {
  id uuid [pk]
  vendor_id uuid [not null]
  address_type varchar(50) [not null]
  address_line1 varchar [not null]
  address_line2 varchar
  city varchar [not null]
  gst_state_id uuid
  country varchar [not null]
  postal_code varchar(20)
  is_default boolean [not null]
  is_active boolean [not null]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp
}

// ============================================================
// SALES CYCLE: QUOTATION -> PROFORMA -> SO -> DC -> SALES INVOICE
// ============================================================

Table quotation {
  id uuid [pk]
  company_id uuid [not null]
  customer_id uuid [not null]
  quotation_number varchar(50) [not null]
  quotation_date date [not null]
  valid_until date [not null]
  reference_number varchar(100)
  quotation_currency varchar(3)
  exchange_rate decimal(19,6)
  subtotal decimal(19,4) [not null]
  discount_amount decimal(19,4)
  freight_charges decimal(19,4)
  other_charges decimal(19,4)
  total_before_round_off decimal(19,4)
  tax_amount decimal(19,4) [not null]
  round_off decimal(19,4)
  total_amount decimal(19,4) [not null]
  place_of_supply_state_id uuid
  place_of_supply_state_code varchar(10)
  delivery_address_id uuid
  delivery_address_line1 varchar
  delivery_address_line2 varchar
  delivery_city varchar
  delivery_state varchar
  delivery_postal_code varchar
  delivery_country varchar
  billing_address_id uuid
  billing_address_line1 varchar
  billing_address_line2 varchar
  billing_city varchar
  billing_state varchar
  billing_postal_code varchar
  billing_country varchar
  billing_state_code varchar(10)
  payment_terms text
  delivery_terms text
  warranty_terms text
  terms_and_conditions text
  notes text
  payment_term_id uuid
  delivery_term_id uuid
  warranty_term_id uuid
  terms_condition_id uuid
  sales_manager_id uuid
  status varchar(30) [not null, default: 'DRAFT']  // QuotationStatus enum
  approved_by uuid
  approved_at timestamp
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, quotation_number) [unique, name: 'uk_quotation_company_number']
    company_id [name: 'idx_quotation_company']
    customer_id [name: 'idx_quotation_customer']
    status [name: 'idx_quotation_status']
    quotation_date [name: 'idx_quotation_date']
    valid_until [name: 'idx_quotation_valid_until']
    quotation_number [name: 'idx_quotation_number']
  }
}

Table quotation_item {
  id uuid [pk]
  company_id uuid [not null]
  quotation_id uuid [not null]
  item_id uuid
  item_name varchar(255) [not null]
  description text
  quantity decimal(19,4) [not null]
  unit varchar(50)
  unit_price decimal(19,4) [not null]
  discount_percent decimal(5,2)
  discount_amount decimal(19,4)
  taxable_amount decimal(19,4) [not null]
  cgst_rate decimal(5,2)
  cgst_amount decimal(19,4)
  sgst_rate decimal(5,2)
  sgst_amount decimal(19,4)
  igst_rate decimal(5,2)
  igst_amount decimal(19,4)
  cess_rate decimal(5,2)
  cess_amount decimal(19,4)
  tax_amount decimal(19,4) [not null]
  total_amount decimal(19,4) [not null]
  hsn_sac_id uuid
  warehouse_id uuid
  location_id uuid
  notes text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    quotation_id [name: 'idx_quotation_item_quotation']
    company_id [name: 'idx_quotation_item_company']
    hsn_sac_id [name: 'idx_quotation_item_hsn']
  }
}

Table quotation_acceptance_token {
  id uuid [pk]
  quotation_id uuid [not null]
  token_hash varchar(64) [unique, not null]
  expires_at timestamp [not null]
  used_at timestamp
  revoked_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table proforma_invoice {
  id uuid [pk]
  company_id uuid [not null]
  pi_number varchar(50) [not null]
  pi_date date [not null]
  pi_valid_till date [not null]
  source_quotation_id uuid
  source_quotation_number varchar(50)
  customer_id uuid [not null]
  billing_address_id uuid
  billing_address_snapshot text
  billing_state_code varchar(2)
  delivery_address_id uuid
  delivery_address_snapshot text
  advance_required boolean [default: false]
  advance_amount decimal(19,4) [default: 0]
  bank_account_id uuid
  bank_details_snapshot text
  reference_number varchar(100)
  currency varchar(3) [not null, default: 'INR']
  exchange_rate decimal(19,6) [not null, default: 1]
  place_of_supply_state_id uuid
  place_of_supply_state_code varchar(2)
  subtotal decimal(19,4) [not null, default: 0]
  discount_amount decimal(19,4) [default: 0]
  tax_amount decimal(19,4) [not null, default: 0]
  freight_charges decimal(19,4) [default: 0]
  other_charges decimal(19,4) [default: 0]
  total_before_round_off decimal(19,4) [not null, default: 0]
  round_off decimal(19,4) [default: 0]
  total_amount decimal(19,4) [not null, default: 0]
  payment_terms text
  delivery_terms text
  terms_and_conditions text
  payment_term_id uuid
  terms_condition_id uuid
  notes text
  status varchar(20) [not null, default: 'DRAFT']  // ProformaInvoiceStatus enum
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar

  indexes {
    company_id [name: 'idx_pi_company']
    customer_id [name: 'idx_pi_customer']
    source_quotation_id [name: 'idx_pi_quotation']
    pi_number [unique, name: 'idx_pi_number']
  }
}

Table proforma_invoice_item {
  id uuid [pk]
  company_id uuid [not null]
  proforma_invoice_id uuid [not null]
  source_quotation_item_id uuid
  item_id uuid
  item_name varchar(255) [not null]
  description text
  quantity decimal(19,4) [not null]
  converted_quantity decimal(19,4) [not null, default: 0]
  remaining_quantity decimal(19,4) [not null, default: 0]
  unit varchar(50)
  unit_price decimal(19,4) [not null]
  discount_percent decimal(5,2)
  discount_amount decimal(19,4)
  taxable_amount decimal(19,4) [not null]
  cgst_rate decimal(5,2)
  cgst_amount decimal(19,4)
  sgst_rate decimal(5,2)
  sgst_amount decimal(19,4)
  igst_rate decimal(5,2)
  igst_amount decimal(19,4)
  cess_rate decimal(5,2)
  cess_amount decimal(19,4)
  tax_amount decimal(19,4) [not null]
  total_amount decimal(19,4) [not null]
  hsn_sac_id uuid
  warehouse_id uuid
  location_id uuid
  notes text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    proforma_invoice_id [name: 'idx_pi_item_pi']
    company_id [name: 'idx_pi_item_company']
  }
}

Table sales_order {
  id uuid [pk]
  company_id uuid [not null]
  so_number varchar(50) [not null]
  so_date date [not null]
  source_pi_id uuid
  source_pi_number varchar(50)
  source_quotation_id uuid
  source_quotation_number varchar(50)
  customer_id uuid [not null]
  billing_address_id uuid
  billing_address_snapshot text
  billing_state_code varchar(2)
  delivery_address_id uuid
  delivery_address_snapshot text
  bank_account_id uuid
  bank_details_snapshot text
  reference_number varchar(100)
  currency varchar(3) [not null, default: 'INR']
  exchange_rate decimal(19,6) [not null, default: 1]
  place_of_supply_state_id uuid
  place_of_supply_state_code varchar(2)
  subtotal decimal(19,4) [not null, default: 0]
  discount_amount decimal(19,4) [default: 0]
  tax_amount decimal(19,4) [not null, default: 0]
  freight_charges decimal(19,4) [default: 0]
  other_charges decimal(19,4) [default: 0]
  total_before_round_off decimal(19,4) [not null, default: 0]
  round_off decimal(19,4) [default: 0]
  total_amount decimal(19,4) [not null, default: 0]
  payment_terms text
  delivery_terms text
  terms_and_conditions text
  payment_term_id uuid
  terms_condition_id uuid
  notes text
  status varchar(20) [not null, default: 'DRAFT']  // SalesOrderStatus enum
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_so_company']
    customer_id [name: 'idx_so_customer']
    source_pi_id [name: 'idx_so_pi']
    so_number [unique, name: 'idx_so_number']
  }
}

Table sales_order_item {
  id uuid [pk]
  company_id uuid [not null]
  sales_order_id uuid [not null]
  source_pi_item_id uuid
  item_id uuid
  item_name varchar(255) [not null]
  description text
  quantity decimal(19,4) [not null]
  unit varchar(50)
  unit_price decimal(19,4) [not null]
  discount_percent decimal(5,2)
  discount_amount decimal(19,4)
  taxable_amount decimal(19,4) [not null]
  cgst_rate decimal(5,2)
  cgst_amount decimal(19,4)
  sgst_rate decimal(5,2)
  sgst_amount decimal(19,4)
  igst_rate decimal(5,2)
  igst_amount decimal(19,4)
  cess_rate decimal(5,2)
  cess_amount decimal(19,4)
  tax_amount decimal(19,4) [not null]
  total_amount decimal(19,4) [not null]
  hsn_sac_id uuid
  warehouse_id uuid
  location_id uuid
  notes text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    sales_order_id [name: 'idx_so_item_so']
    company_id [name: 'idx_so_item_company']
  }
}

Table delivery_challan {
  id uuid [pk]
  company_id uuid [not null]
  dc_number varchar(50) [not null]
  dc_date date [not null]
  source_so_id uuid
  source_so_number varchar(50)
  source_si_id uuid
  source_si_number varchar(50)
  source_rv_id uuid
  source_rv_number varchar(50)
  customer_id uuid [not null]
  billing_address_id uuid
  billing_address_snapshot text
  billing_state_code varchar(2)
  delivery_address_id uuid
  delivery_address_snapshot text
  dispatch_date date
  transporter_id uuid
  vehicle_number varchar(50)
  lr_number varchar(100)
  reference_number varchar(100)
  subtotal decimal(19,4) [not null, default: 0]
  discount_amount decimal(19,4) [default: 0]
  tax_amount decimal(19,4) [not null, default: 0]
  total_amount decimal(19,4) [not null, default: 0]
  notes text
  status varchar(20) [not null, default: 'DRAFT']  // DeliveryChallanStatus enum
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_dc_company']
    customer_id [name: 'idx_dc_customer']
    source_so_id [name: 'idx_dc_so']
    source_si_id [name: 'idx_dc_si']
    source_rv_id [name: 'idx_dc_rv']
    dc_number [unique, name: 'idx_dc_number']
  }
}

Table delivery_challan_item {
  id uuid [pk]
  company_id uuid [not null]
  delivery_challan_id uuid [not null]
  source_so_item_id uuid
  source_si_item_id uuid
  item_id uuid
  item_name varchar(255) [not null]
  description text
  quantity decimal(19,4) [not null]
  unit varchar(50)
  unit_price decimal(19,4) [not null]
  discount_percent decimal(5,2)
  discount_amount decimal(19,4)
  taxable_amount decimal(19,4) [not null]
  cgst_rate decimal(5,2)
  cgst_amount decimal(19,4)
  sgst_rate decimal(5,2)
  sgst_amount decimal(19,4)
  igst_rate decimal(5,2)
  igst_amount decimal(19,4)
  cess_rate decimal(5,2)
  cess_amount decimal(19,4)
  tax_amount decimal(19,4) [not null]
  total_amount decimal(19,4) [not null]
  hsn_sac_id uuid
  warehouse_id uuid
  location_id uuid
  notes text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
