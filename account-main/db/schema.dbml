// ============================================================
// PURCHASE CYCLE: PR -> RFQ -> SQ -> PO -> GRN -> AP INVOICE
// ============================================================

Table purchase_requisition {
  id uuid [pk]
  company_id uuid [not null]
  requisition_number varchar(50) [not null]
  requisition_name varchar(255)
  requester_id uuid
  department_id uuid
  cost_center_id uuid
  required_date date [not null]
  priority varchar(20) [not null, default: 'NORMAL']
  purpose text
  status varchar(20) [not null, default: 'DRAFT']  // PurchaseRequisitionStatus enum
  submitted_by uuid
  submitted_at timestamp
  approved_by uuid
  approved_at timestamp
  rejected_by uuid
  rejected_at timestamp
  rejection_reason text
  cancelled_by uuid
  cancelled_at timestamp
  remarks text
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_prq_company']
    status [name: 'idx_prq_status']
    requisition_number [unique, name: 'idx_prq_number']
  }
}

Table purchase_requisition_item {
  id uuid [pk]
  company_id uuid [not null]
  purchase_requisition_id uuid [not null]
  item_id uuid
  item_name varchar(255) [not null]
  description text
  item_type varchar(20) [default: 'PRODUCT']  // ItemType enum
  requested_quantity decimal(19,4) [not null]
  unit varchar(50)
  estimated_unit_price decimal(19,4)
  estimated_amount decimal(19,4)
  required_date date
  warehouse_id uuid
  location_id uuid
  remarks text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    purchase_requisition_id [name: 'idx_prqi_requisition']
    company_id [name: 'idx_prqi_company']
  }
}

Table rfq {
  id uuid [pk]
  company_id uuid [not null]
  rfq_number varchar(50) [not null]
  purchase_requisition_id uuid [not null]
  issue_date date [not null]
  quotation_deadline date
  expected_delivery_date date
  terms text
  notes text
  status varchar(30) [not null, default: 'DRAFT']  // RfqStatus enum
  version bigint
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    company_id [name: 'idx_rfq_company']
    status [name: 'idx_rfq_status']
    rfq_number [unique, name: 'idx_rfq_number']
  }
}

Table rfq_item {
  id uuid [pk]
  company_id uuid [not null]
  rfq_id uuid [not null]
  item_id uuid
  item_name varchar [not null]
  description text
  item_type varchar(20)  // ItemType enum
  quantity decimal(19,4) [not null]
  unit varchar(50)
  required_date date
  specifications text
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    rfq_id [name: 'idx_rfqi_rfq']
    company_id [name: 'idx_rfqi_company']
  }
}

Table rfq_vendor {
