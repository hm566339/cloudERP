Table bank_account {
  id uuid [pk]
  company_id uuid [not null]
  bank_name varchar(200) [not null]
  branch_name varchar(200)
  account_number varchar(40) [not null]
  ifsc_code varchar(20) [not null]
  account_holder_name varchar(255)
  swift_code varchar(20)
  is_primary boolean [default: false]
  upi_id varchar(100)
  account_type varchar(20) [not null]  // BankAccountType enum
  opening_balance decimal(19,4) [not null]
  gl_account_id uuid [not null]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, account_number) [unique]
  }
}

Table bank_transaction {
  id uuid [pk]
  company_id uuid [not null]
  bank_account_id uuid [not null]
  transaction_date date [not null]
  reference_no varchar(100) [not null]
  utr_no varchar(50)
  transaction_type varchar(20) [not null]  // BankTransactionType enum
  debit_amount decimal(19,4)
  credit_amount decimal(19,4)
  narration varchar(1000)
  reconciled boolean [default: false]
  reconciled_date timestamp
  gl_journal_entry_id uuid
  gl_posting_status varchar(30)  // PostingStatus enum
  created_at timestamp
  updated_at timestamp
  created_by uuid
  created_by_username varchar
  updated_by uuid
  updated_by_username varchar
  is_deleted boolean [default: false]
  deleted_by uuid
  deleted_by_username varchar
  deleted_at timestamp

  indexes {
    (company_id, transaction_date) [name: 'idx_company_date']
    (bank_account_id, transaction_date) [name: 'idx_bank_account_date']
    (reference_no, company_id) [name: 'idx_reference_company']
    (utr_no, company_id) [name: 'idx_utr_company']
    reconciled [name: 'idx_reconciled']
  }
}

Table ap_payment {
  id uuid [pk]
