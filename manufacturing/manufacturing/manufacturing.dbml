  unit_cost decimal(19,4) [not null, default: 0]
  total_cost decimal(19,6) [not null, default: 0]
  inventory_movement_line_id uuid [note: 'External Inventory stock_movement_line UUID - no FK']
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  is_deleted boolean [not null, default: false]

  indexes {
    production_completion_id [name: 'idx_production_completion_line_completion']
    product_id [name: 'idx_production_completion_line_product']
    batch_id [name: 'idx_production_completion_line_batch']
    serial_id [name: 'idx_production_completion_line_serial']
    inventory_movement_line_id [name: 'idx_production_completion_line_movement_line']
    company_id [name: 'idx_production_completion_line_company']
  }
}

// ============================================================
// 14. PRODUCTION SCRAP
// ============================================================

Table production_scrap {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  production_order_id uuid [not null]
  scrap_product_id uuid [not null, note: 'External Inventory product UUID - no FK']
  quantity decimal(19,6) [not null]
  uom_id uuid [not null, note: 'External Inventory UOM UUID - no FK']
  warehouse_id uuid [note: 'External Inventory warehouse UUID - no FK']
  location_id uuid [note: 'External Inventory location UUID - no FK']
  reason varchar
