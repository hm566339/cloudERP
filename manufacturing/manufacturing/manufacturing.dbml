  status scrap_status [not null, default: 'DRAFT']
  inventory_movement_id uuid [note: 'External Inventory stock_movement UUID - no FK']
  approved_by uuid
  approved_at timestamp
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  is_deleted boolean [not null, default: false]

  indexes {
    production_order_id [name: 'idx_production_scrap_order']
    scrap_product_id [name: 'idx_production_scrap_product']
    inventory_movement_id [name: 'idx_production_scrap_movement']
    company_id [name: 'idx_production_scrap_company']
  }
}

// ============================================================
// 15. PRODUCTION WIP (Manufacturing-side logical state only)
// ============================================================

Table production_wip {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  production_order_id uuid [not null]
  status wip_status [not null, default: 'NOT_STARTED']
  started_at timestamp
  completed_at timestamp
  material_cost decimal(19,4) [not null, default: 0]
  labor_cost decimal(19,4) [not null, default: 0]
  machine_cost decimal(19,4) [not null, default: 0]
  overhead_cost decimal(19,4) [not null, default: 0]
  total_wip_cost decimal(19,4) [not null, default: 0]
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  is_deleted boolean [not null, default: false]

  indexes {
    (company_id, production_order_id) [unique, name: 'uk_production_wip_company_order']
    production_order_id [name: 'idx_production_wip_order']
    company_id [name: 'idx_production_wip_company']
    status [name: 'idx_production_wip_status']
  }

  Note: 'Manufacturing-side logical WIP state tracking only. This is NOT a stock ledger and does not duplicate Inventory stock.'
}

// ============================================================
// 16. PRODUCTION GENEALOGY
// ============================================================

Table production_genealogy {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  production_order_id uuid [not null]
  production_completion_id uuid
  input_product_id uuid [note: 'External Inventory product UUID - no FK']
  input_batch_id uuid [note: 'External Inventory batch UUID - no FK']
  input_serial_id uuid [note: 'External Inventory serial UUID - no FK']
  input_quantity decimal(19,6)
  input_uom_id uuid [note: 'External Inventory UOM UUID - no FK']
  output_product_id uuid [note: 'External Inventory product UUID - no FK']
  output_batch_id uuid [note: 'External Inventory batch UUID - no FK']
  output_serial_id uuid [note: 'External Inventory serial UUID - no FK']
  output_quantity decimal(19,6)
  output_uom_id uuid [note: 'External Inventory UOM UUID - no FK']
  relationship_type genealogy_relationship_type [not null]
  created_at timestamp [not null, default: `now()`]
  created_by uuid

  indexes {
    production_order_id [name: 'idx_genealogy_order']
    production_completion_id [name: 'idx_genealogy_completion']
    input_product_id [name: 'idx_genealogy_input_product']
    input_batch_id [name: 'idx_genealogy_input_batch']
    input_serial_id [name: 'idx_genealogy_input_serial']
    output_product_id [name: 'idx_genealogy_output_product']
    output_batch_id [name: 'idx_genealogy_output_batch']
    output_serial_id [name: 'idx_genealogy_output_serial']
    company_id [name: 'idx_genealogy_company']
  }

  Note: 'All product/UOM/batch/serial references are external Inventory UUIDs (no DBML Ref).'
}

// ============================================================
// 17. PRODUCTION COST
// ============================================================

Table production_cost {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  production_order_id uuid [not null]
  material_cost decimal(19,4) [not null, default: 0]
  labor_cost decimal(19,4) [not null, default: 0]
  machine_cost decimal(19,4) [not null, default: 0]
  overhead_cost decimal(19,4) [not null, default: 0]
  subcontract_cost decimal(19,4) [not null, default: 0]
  scrap_recovery decimal(19,4) [not null, default: 0]
  by_product_credit decimal(19,4) [not null, default: 0]
  total_cost decimal(19,4) [not null, default: 0]
  good_output_quantity decimal(19,6) [not null, default: 0]
  cost_per_unit decimal(19,6) [not null, default: 0]
  currency_code varchar(3) [not null, default: 'INR']
  status production_cost_status [not null, default: 'DRAFT']
  calculated_at timestamp
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  is_deleted boolean [not null, default: false]

  indexes {
    (company_id, production_order_id) [unique, name: 'uk_production_cost_company_order']
  }

  Note: 'Manufacturing-side cost rollup only. Does not create GL/accounting tables.'
}

// ============================================================
// 18. MANUFACTURING OUTBOX
// ============================================================

Table manufacturing_outbox {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  aggregate_type varchar [not null]
  aggregate_id uuid [not null]
  event_type outbox_event_type [not null]
  idempotency_key varchar [not null]
  payload jsonb [not null]
  status outbox_status [not null, default: 'PENDING']
  retry_count integer [not null, default: 0]
  next_attempt_at timestamp
  last_error text
  processed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, idempotency_key) [unique, name: 'uk_mfg_outbox_company_idempotency']
    company_id [name: 'idx_mfg_outbox_company']
    aggregate_type [name: 'idx_mfg_outbox_aggregate_type']
    aggregate_id [name: 'idx_mfg_outbox_aggregate_id']
    event_type [name: 'idx_mfg_outbox_event_type']
    status [name: 'idx_mfg_outbox_status']
    next_attempt_at [name: 'idx_mfg_outbox_next_attempt']
  }
}

// ============================================================
// RELATIONSHIPS (Manufacturing-owned tables only)
// ============================================================

Ref: bom_revision.bom_id > bom.id
Ref: bom_item.bom_revision_id > bom_revision.id
Ref: bom_output.bom_revision_id > bom_revision.id

Ref: production_order.bom_id > bom.id
Ref: production_order.bom_revision_id > bom_revision.id

Ref: production_order_bom_snapshot.production_order_id > production_order.id
Ref: production_order_material_snapshot.production_order_bom_snapshot_id > production_order_bom_snapshot.id
Ref: production_order_material_snapshot.bom_item_id > bom_item.id

Ref: production_order_material.production_order_id > production_order.id
Ref: production_order_material.bom_item_id > bom_item.id

Ref: production_order_output.production_order_id > production_order.id

Ref: material_consumption.production_order_id > production_order.id
Ref: material_consumption.production_order_material_id > production_order_material.id

Ref: production_completion.production_order_id > production_order.id
Ref: production_completion_line.production_completion_id > production_completion.id

Ref: production_scrap.production_order_id > production_order.id

Ref: production_wip.production_order_id > production_order.id

Ref: production_genealogy.production_order_id > production_order.id
Ref: production_genealogy.production_completion_id > production_completion.id

Ref: production_cost.production_order_id > production_order.id

// No Ref relationships are created for external Inventory or Account UUID
// columns (company_id, product_id, uom_id, warehouse_id, location_id,
// batch_id, serial_id, inventory_reservation_id, inventory_movement_id,
// inventory_movement_line_id). These remain plain UUID columns per the
// no-cross-database-FK requirement.
