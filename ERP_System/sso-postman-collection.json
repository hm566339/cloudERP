{
  "info": {
    "name": "SSO Auth Flow Testing",
    "_postman_id": "12345-abcde-67890",
    "description": "SSO Authorization Code Flow Testing Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "sso_base_url", "value": "http://localhost:8080" },
    { "key": "client_base_url", "value": "http://localhost:8081" },
    { "key": "client_id", "value": "YOUR_CLIENT_ID" },
    { "key": "client_secret", "value": "YOUR_CLIENT_SECRET" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "auth_code", "value": "" }
  ],
  "item": [

    {
      "name": "1. Generate Auth Code (Login)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{sso_base_url}}/api/v1/auth/authorization-code",
          "host": ["{{sso_base_url}}"],
          "path": ["api", "v1", "auth", "authorization-code"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"test\",\n  \"password\": \"1234\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('auth_code', json.code);"
            ]
          }
        }
      ]
    },

    {
      "name": "2. Exchange Code → Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{sso_base_url}}/api/v1/token/exchange",
          "host": ["{{sso_base_url}}"],
          "path": ["api", "v1", "token", "exchange"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{auth_code}}\",\n  \"clientId\": \"{{client_id}}\",\n  \"clientSecret\": \"{{client_secret}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('access_token', json.accessToken);",
              "pm.collectionVariables.set('refresh_token', json.refreshToken);"
            ]
          }
        }
      ]
    },

    {
      "name": "3. Verify Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{sso_base_url}}/api/v1/token/verify",
          "host": ["{{sso_base_url}}"],
          "path": ["api", "v1", "token", "verify"]
        }
      }
    },

    {
      "name": "4. Get Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{sso_base_url}}/api/v1/auth/me",
          "host": ["{{sso_base_url}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      }
    },

    {
      "name": "5. Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{sso_base_url}}/api/v1/token/refresh",
          "host": ["{{sso_base_url}}"],
          "path": ["api", "v1", "token", "refresh"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\",\n  \"clientId\": \"{{client_id}}\",\n  \"clientSecret\": \"{{client_secret}}\"\n}"
        }
      }
    },

    {
      "name": "6. Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{sso_base_url}}/api/v1/auth/logout",
          "host": ["{{sso_base_url}}"],
          "path": ["api", "v1", "auth", "logout"]
        }
      }
    }

  ]
}